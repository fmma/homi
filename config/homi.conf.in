# This configuration file should be written in TOML format.

# CRITICAL = 0, WARNING = 1, NOTICE = 2, INFO = 3, DEBUG = 4
log_level = 2

# Devices is a list of dev URIs as strings. An entry may name the mount point of
# the filesystem that device holds, which overrides 'xal.mountpoint' below, e.g.
# devices = [ "0000:01:00.0=/mnt/homi0", "0000:02:00.0=/mnt/homi1" ]
# With more than one device, give every entry its own mount point: that is what
# keeps each device indexed against its own filesystem.
devices = [ ]

# IPC socket
ipc_socket = "/run/homi/homi.sock"

# xNVMe multi-process group. The daemon owns the controller as the group primary;
# clients join it as secondaries by opening the same device with the same id.
# Clients default to 1, so leave this alone unless two daemons share a host.
shm_id = 1

[xal]
# xfs = 1, fiemap = 2
backend = 2
# none = 0, dirty detection = 1, extent update = 2
watchmode = 2
# traverse = 0, hashmap = 1
file_lookupmode = 0
